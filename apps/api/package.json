{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "tsx --test src/cors.test.ts src/docs.test.ts",
    "test:cors": "tsx --test src/cors.test.ts",
    "test:docs": "tsx --test src/docs.test.ts",
    "test:integration": "tsx --test src/all-routes.test.ts",
    "test:all": "tsx --test src/cors.test.ts src/docs.test.ts src/all-routes.test.ts"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/docs": "workspace:*",
    "@repo/products": "workspace:*",
    "@repo/rate-limiting": "workspace:*",
    "@trpc/server": "^11.18.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "superjson": "^2.2.6",
    "tsx": "^4.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "typescript": "7.0.2"
  }
}
