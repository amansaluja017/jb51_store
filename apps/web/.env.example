# JB51 Store Frontend Environment Variables

# The URL of the backend API server (defaults to http://localhost:3001 in dev)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Social / Contact handles for the storefront UI
NEXT_PUBLIC_SITE_URL=https://jb51.shop
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_INSTAGRAM_HANDLE=jb51clothing
NEXT_PUBLIC_COMPANY_EMAIL=support@jb51.shop

# Development flags
# DISABLE_HMR=true # Uncomment to disable Hot Module Replacement